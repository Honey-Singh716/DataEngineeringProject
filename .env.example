# ──────────────────────────────────────────────────────────
# Road Insight – Environment Configuration Template
# Copy to .env and fill real values (never commit .env)
# ──────────────────────────────────────────────────────────

# --- Groq API (Text-to-SQL AI Analyst) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30

# --- Dashboard Database Connection (Preferred for Streamlit UI) ---
# Least-privilege account with SELECT on all analytical tables & 9 views.
# See: scripts/setup_dashboard_role.sql
DASHBOARD_DATABASE_URL=postgresql+psycopg://roadinsight_dashboard:CHANGE_ME@localhost:5432/roadinsight

# --- Read-Only PostgreSQL Account for AI Analyst Query Engine ---
# Dedicated isolated role with strict boundaries (no staging, no catalog).
# See: scripts/setup_readonly_role.sql
READONLY_DATABASE_URL=postgresql+psycopg://roadinsight_readonly:CHANGE_ME@localhost:5432/roadinsight

# --- Execution Safety Guardrails ---
QUERY_TIMEOUT_SECONDS=3
MAX_RESULT_ROWS=100

