# ──────────────────────────────────────────────────────────
# Road Insight – AI Analyst Backend
# Environment template  (copy to .env and fill values)
# ──────────────────────────────────────────────────────────

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30

# --- Read-only PostgreSQL account for the AI Analyst ---
# Create this role BEFORE enabling query execution.
# See: scripts/setup_readonly_role.sql
READONLY_DATABASE_URL=postgresql+psycopg://readonly_user:CHANGE_ME@your-host:5432/roadinsight

# --- Execution safety ---
QUERY_TIMEOUT_SECONDS=3
MAX_RESULT_ROWS=100

